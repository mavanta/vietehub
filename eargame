--// Function

local function removePromptCooldown()
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			v.HoldDuration = 0
			v.MaxActivationDistance = math.max(v.MaxActivationDistance, 20)
		end
	end
end
workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("ProximityPrompt") then
		obj.HoldDuration = 0
	end
end)

local function tp(cf)
	local char = Player.Character
	if not char then return end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = cf
	end
end
local function firePrompt(prompt)
	if not prompt then return end

	pcall(function()
		fireproximityprompt(prompt)
	end)

	-- fallback nếu executor không có fireproximityprompt
	pcall(function()
		ProximityPromptService:InputHoldBegin(prompt)
		task.wait()
		ProximityPromptService:InputHoldEnd(prompt)
	end)
end

local function getNearbyPrompt(part)
	local closest
	local distance = math.huge

	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("ProximityPrompt") and v.Parent:IsA("BasePart") then
			local d = (v.Parent.Position - part.Position).Magnitude

			if d < distance and d <= 15 then
				distance = d
				closest = v
			end
		end
	end

	return closest
end

local running = false
local function collectScraps()
	local scrapsFolder = workspace:FindFirstChild("Scraps")

	if not scrapsFolder then
		warn("Không tìm thấy folder Scraps")
		return
	end

	for _, item in ipairs(scrapsFolder:GetChildren()) do
		if not running then return end

		if item:IsA("BasePart") then
			tp(item.CFrame + Vector3.new(0, 3, 0))

			task.wait(0.2)

			local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
				or getNearbyPrompt(item)

			if prompt then
				firePrompt(prompt)
				ScrapCount += 1
			end

			task.wait(0.1)
		end
	end
end

local function recycleTools()
	local recycler = workspace:FindFirstChild("Recycle item", true)

	if not recycler or not recycler:IsA("BasePart") then
		return
	end

	tp(recycler.CFrame + Vector3.new(0, 3, 0))

	task.wait(0.2)

	local prompt = recycler:FindFirstChildWhichIsA("ProximityPrompt", true)

	if not prompt then
		for _, v in ipairs(recycler:GetDescendants()) do
			if v:IsA("ProximityPrompt") then
				prompt = v
				break
			end
		end
	end

	if not prompt then
		return
	end

	local backpack = Player:WaitForChild("Backpack")
	local char = Player.Character

	for _, tool in ipairs(backpack:GetChildren()) do
		if not running then return end

		if tool:IsA("Tool") then
			tool.Parent = char

			task.wait(0.1)

			firePrompt(prompt)

			task.wait(0.1)
		end
	end
end

